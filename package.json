{
  "name": "rough-draft-ds",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Rough Draft design system: tokens, components, patterns and the living style guide.",
  "scripts": {
    "tokens": "node scripts/build-tokens.mjs",
    "contrast": "node scripts/contrast-report.mjs",
    "dev": "npm run tokens && vite --port 5240 --strictPort",
    "build": "npm run tokens && npm run contrast && tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
